#!/bin/bash

DIRNAME=$(dirname "$0")
SCRIPT_PATH=$(cd "$DIRNAME"; pwd -P)
if [ -e "$SCRIPT_PATH/config" ]; then
    . "$SCRIPT_PATH/config"
fi

QUEUE="$1"
shift 1
. "$SCRIPT_PATH/config"
if [ -e "$SCRIPT_PATH/config.$QUEUE" ]; then
    . "$SCRIPT_PATH/config.$QUEUE"
fi

if [ -z "$QUEUE" -o "$QUEUE" == "default" ]; then
    OUTCONFIG="config"
else
    OUTCONFIG="config.$QUEUE"
fi

function readdata {
    DEFAULT=$1
    read DATA
    if [ -n "$DATA" ]; then
	echo "$DATA"
    else
	echo "$DEFAULT"
    fi
}

echo "Remote hostname: [$REMOTE_HOST]"
REMOTE_HOST=$(readdata "$REMOTE_HOST")

echo "Username: [$USERNAME]"
USERNAME=$(readdata "$USERNAME")

echo "Directory on remote host to keep runs and httk files: [$REMOTE_HTTK_DIR]"
REMOTE_HTTK_DIR=$(readdata "$REMOTE_HTTK_DIR")

if [ "${REMOTE_HTTK_DIR:0:1}" = "/" -o "${REMOTE_HTTK_DIR:0:1}" = "~" ]; then
    REMOTE_HTTK_DIR="$REMOTE_HTTK_DIR"
else
    REMOTE_HTTK_DIR="~/$REMOTE_HTTK_DIR"
fi

echo "Slurm project to submit jobs to (often a separate GPU project): [$SLURM_PROJECT]"
SLURM_PROJECT=$(readdata "$SLURM_PROJECT")

echo "Slurm partition with GPU nodes (enter 'none' to not specify a partition): [$SLURM_PARTITION]"
SLURM_PARTITION=$(readdata "$SLURM_PARTITION")
if [ "$SLURM_PARTITION" == "none" ]; then
    SLURM_PARTITION=""
fi

echo "Number of GPUs per job (vasp runs one MPI rank per GPU): [$SLURM_GPUS]"
SLURM_GPUS=$(readdata "$SLURM_GPUS")

echo "Number of CPU cores to allocate per GPU: [$SLURM_CPUS_PER_GPU]"
SLURM_CPUS_PER_GPU=$(readdata "$SLURM_CPUS_PER_GPU")

echo "Number of OpenMP threads per MPI rank, at most the CPU cores per GPU: [$VASP_OMP_THREADS]"
VASP_OMP_THREADS=$(readdata "$VASP_OMP_THREADS")

echo "Commands to run before vasp, e.g. module load, conda activate or export PATH, separate several commands with ';' (enter 'none' for no commands): [$SETUP_COMMANDS]"
SETUP_COMMANDS=$(readdata "$SETUP_COMMANDS")
if [ "$SETUP_COMMANDS" == "none" ]; then
    SETUP_COMMANDS=""
fi

echo "Command to run vasp (srun takes the number of MPI ranks, GPUs and OpenMP threads from the answers above): [$VASP_COMMAND]"
VASP_COMMAND=$(readdata "$VASP_COMMAND")

echo "Vasp pseudopotential path (should be an absolute path, starting with / ): [$VASP_PSEUDO_PATH]"
VASP_PSEUDO_PATH=$(readdata "$VASP_PSEUDO_PATH")

if [ "${VASP_PSEUDO_PATH:0:1}" = "/" -o "${VASP_PSEUDO_PATH:0:1}" = "~" ]; then
    VASP_PSEUDO_PATH="$VASP_PSEUDO_PATH"
else
    VASP_PSEUDO_PATH="~/$VASP_PSEUDO_PATH"
fi

echo "Slurm job timeout (GPU time is expensive, avoid setting this too high) [$SLURM_TIMEOUT]"
SLURM_TIMEOUT=$(readdata "$SLURM_TIMEOUT")

echo "Taskmanager timeout max time per task in seconds: [$TASKMGR_JOB_TIMEOUT]"
TASKMGR_JOB_TIMEOUT=$(readdata "$TASKMGR_JOB_TIMEOUT")

# Single quotes, so that e.g. \$PATH is expanded in the job and not when config is read
QUOTE="'"
ESCAPED_QUOTE="'\\''"
SETUP_COMMANDS_QUOTED=${SETUP_COMMANDS//$QUOTE/$ESCAPED_QUOTE}

cat - > "$OUTCONFIG" <<EOF
REMOTE_HOST="$REMOTE_HOST"
REMOTE_HTTK_DIR="$REMOTE_HTTK_DIR"
USERNAME="$USERNAME"
VASP_COMMAND="$VASP_COMMAND"
SETUP_COMMANDS='$SETUP_COMMANDS_QUOTED'
VASP_PSEUDO_PATH="$VASP_PSEUDO_PATH"
VASP_OMP_THREADS="$VASP_OMP_THREADS"
SLURM_PROJECT="$SLURM_PROJECT"
SLURM_PARTITION="$SLURM_PARTITION"
SLURM_GPUS="$SLURM_GPUS"
SLURM_CPUS_PER_GPU="$SLURM_CPUS_PER_GPU"
SLURM_TIMEOUT="$SLURM_TIMEOUT"
TASKMGR_JOB_TIMEOUT="$TASKMGR_JOB_TIMEOUT"
EOF
